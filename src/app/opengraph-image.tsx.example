// Example of dynamic OG image generation
// Rename to opengraph-image.tsx to use

import { ImageResponse } from 'next/og'

export const runtime = 'edge'
export const alt = 'CheekoAI - Smart AI Companion for Kids'
export const size = {
  width: 1200,
  height: 630,
}
export const contentType = 'image/png'

export default async function Image() {
  return new ImageResponse(
    (
      <div
        style={{
          fontSize: 128,
          background: '#f36e24',
          width: '100%',
          height: '100%',
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'center',
          flexDirection: 'column',
        }}
      >
        <div style={{ fontSize: 60, color: 'white', marginBottom: 20 }}>
          CheekoAI
        </div>
        <div style={{ fontSize: 40, color: 'white' }}>
          Smart AI Companion for Kids
        </div>
      </div>
    ),
    {
      ...size,
    }
  )
}